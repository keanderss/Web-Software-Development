<!DOCTYPE html>
<html>
  <head>
    <title>Hello there!</title>
  </head>
  <body>
    <h1>Value for <%= it.object %>: <%= it.value %>
      <% if (it.value < 0) { %>
        (negative)
      <% } else if (it.value > 0) { %>
        (positive)
      <% } else { %>
        (zero)
      <% } %> 
    </h1>
  </body>
</html>  