<!DOCTYPE html>
<html>
  <head>
    <title>Songs and durations!</title>
  </head>
  <body>
    <h1>Songs</h1>
    <!-- add a form for adding songs here -->
    <form method="POST" action="/songs">
      <label for="Song name">Song name</label>
      <input type="text" id="Song name" name="name" />
      <br/>
      <label for="Song duration">Song duration</label>
      <input type="number" id="Song duration" name="duration" />
      <br/>
      <input type="submit" value="Submit"></input>
    </form>
    <table>
      <tr>
        <th>Song name</th>
        <th>Duration (seconds)</th>
      </tr>
      <!-- songs from the server should be listed here -->
      <% it.songs.forEach((song) => { %>
        <tr>
          <td><%= song.name %></td>
          <td><%= song.duration %></td>
        </tr>
      <% }); %>
    </table>
  </body>
</html>